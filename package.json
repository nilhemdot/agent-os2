{
  "name": "agentos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first control plane for coding-agent runtimes",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "bin": {
    "agentos": "./bin/agentos"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "playwright test",
    "build:web": "npm run build -w @agentos/web",
    "agentos": "node --experimental-strip-types --experimental-sqlite --disable-warning=ExperimentalWarning apps/cli/src/main.ts",
    "daemon": "node --experimental-strip-types --experimental-sqlite --disable-warning=ExperimentalWarning apps/daemon/src/main.ts",
    "dev:web": "npm run dev -w @agentos/web",
    "smoke": "bash scripts/e2e-smoke.sh"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@vitest/coverage-v8": "3.2.4",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
