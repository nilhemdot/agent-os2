{
  "mcpServers": {
    "files": {
      "command": "npx",
      "args": ["@modelcontextprotocol/server-filesystem@1.2.3", "./"]
    },
    "github": {
      "command": "npx",
      "args": ["github-mcp-demo@1.0.0"],
      "env": { "GITHUB_TOKEN": "${GITHUB_TOKEN}" }
    },
    "leaderboard": {
      "type": "http",
      "url": "https://leaderboard.example.invalid/mcp",
      "headers": { "Authorization": "Bearer ${LEADERBOARD_TOKEN}" }
    }
  }
}
